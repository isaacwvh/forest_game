# Copy to backend/.env. Local Docker game PostgreSQL is retained.
FOREST_ENVIRONMENT=local
FOREST_DATABASE_URL=postgresql+psycopg://forest:forest-local-only@127.0.0.1:5432/forest
FOREST_AUTH_MODE=jwks
FOREST_AUTH_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
FOREST_AUTH_AUDIENCE=authenticated
FOREST_AUTH_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# Match the project's active asymmetric key; ES256 is not the backend default.
FOREST_AUTH_ALGORITHM=ES256
# No database migration to Supabase and no admin/service-role key is required.
