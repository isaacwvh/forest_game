# Local development only. Copy to backend/.env; replace the signing secret.
FOREST_ENVIRONMENT=local
FOREST_DATABASE_URL=postgresql+psycopg://forest:forest-local-only@127.0.0.1:5432/forest
FOREST_AUTH_MODE=development
# Optional payload-free SQL/write/response/transaction metrics; default is off.
FOREST_OPERATION_METRICS_ENABLED=false
# Optional shared maintenance worker; each family remains disabled until accepted.
FOREST_MAINTENANCE_RESPONSES_ENABLED=false
FOREST_MAINTENANCE_VISITORS_ENABLED=false
FOREST_MAINTENANCE_GROWTH_ENABLED=false
FOREST_MAINTENANCE_INTERVAL_SECONDS=60
FOREST_MAINTENANCE_BATCH_LIMIT=500
FOREST_DEV_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Production/staging: AUTH_MODE=jwks and set your managed provider's values.
# FOREST_AUTH_ISSUER=https://your-provider.example/
# FOREST_AUTH_AUDIENCE=movement-forest
# FOREST_AUTH_JWKS_URL=https://your-provider.example/.well-known/jwks.json
# FOREST_AUTH_ALGORITHM=RS256
