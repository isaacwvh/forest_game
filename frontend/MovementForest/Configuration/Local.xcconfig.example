// Copy to Local.xcconfig beside this file. $() prevents // becoming a comment.
// Auth.xcconfig supplies the shared Singapore URL and public publishable key.
// Old local Supabase URL/key entries are superseded by that tracked configuration.
FOREST_GAME_API_URL = https:/$()/YOUR_PRIVATE_API_HOST
// Choose your own bundle identifier/team in Xcode before enabling Apple.
FOREST_AUTH_GOOGLE_ENABLED = YES
FOREST_AUTH_GUEST_ENABLED = YES
FOREST_AUTH_APPLE_ENABLED = NO
// Enable only after configuring Sign in with Apple for this App ID:
// CODE_SIGN_ENTITLEMENTS = MovementForest/Configuration/MovementForestApple.entitlements
